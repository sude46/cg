logs/
elasticsearch/
*.zip
# 上传的图片（本地存储，运行时生成，不入库）
app/static/uploads/
# 系统垃圾
.DS_Store
.env.bak*
instance/

# 压测产物：保留汇总 CSV，忽略 HTML/历史大文件
tests/performance/results/*.html
tests/performance/results/*_stats_history.csv
