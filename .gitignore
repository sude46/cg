# 密钥与环境——永不入库
.env
*.pem
*.key

# Python 产物
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
# 编辑器 / AI 工具
.cursor
.opencode/
.vscode/
.idea/
