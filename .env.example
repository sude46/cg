# .env 关键配置（替换后的完整密钥）
# 数据库配置（保留你原有内容）
DEV_DATABASE_URL=<please-fill-in>
REPLICA_DATABASE_URL=<please-fill-in>
MYSQL_HOST=weibo-mysql-master
MYSQL_USER=weibo
MYSQL_PASSWORD=<please-fill-in>
MYSQL_DB=weibo

# Redis 配置
REDIS_HOST=weibo-redis-master
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=<please-fill-in>
REDIS_URL=<please-fill-in>
REDIS_SENTINEL_HOST=weibo-redis-sentinel-1:26379,weibo-redis-sentinel-2:26379,weibo-redis-sentinel-3:26379
REDIS_SENTINEL_MASTER_NAME=mymaster

#Celery
CELERY_BROKER_URL=<please-fill-in>
CELERY_RESULT_BACKEND=<please-fill-in>

#Elasticsearch
ELASTICSEARCH_ENABLED=true
ELASTICSEARCH_HOSTS=http://elasticsearch-cn:9200
ELASTICSEARCH_TIMEOUT=30

# MFA TOTP secret 加密密钥（Fernet；用 utils.security_utils.generate_mfa_encryption_key 生成）
MFA_ENCRYPTION_KEY=<please-fill-in>

# 图片上传（本地存储；生产可切 s3 并改 STORAGE_PUBLIC_BASE 指向 CDN）
STORAGE_BACKEND=local
STORAGE_PUBLIC_BASE=/uploads/files
UPLOAD_MAX_BYTES=5242880


# 邮件/限流/BCRYPT 配置（保留你原有内容）
MAIL_SERVER=<please-fill-in>
MAIL_PORT=587
MAIL_USERNAME=<please-fill-in>
MAIL_PASSWORD=<please-fill-in>
MAIL_USE_TLS=True
MAIL_USE_SSL=False
RATE_LIMIT_STORAGE=<please-fill-in>
RATE_LIMIT_DEFAULT=100 per minute
BCRYPT_LOG_ROUNDS=12

SECRET_KEY=<please-fill-in>
JWT_SECRET_KEY=<please-fill-in>

# 测试环境配置
TEST_DATABASE_URL=<please-fill-in>
TEST_JWT_SECRET=<please-fill-in>



MYSQL_ROOT_PASSWORD=<please-fill-in>
REPL_PASS=<please-fill-in>
MYSQL_EXPORTER_PASSWORD=<please-fill-in>

BIG_V_THRESHOLD=1000
